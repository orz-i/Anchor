{
  "name": "anchor-desktop",
  "version": "0.1.23",
  "description": "Anchor desktop workspace gateway",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "desktop": "node scripts/run-with-rust-toolchain.mjs tauri dev",
    "desktop:build": "node scripts/prepare-desktop-build.mjs && node scripts/run-with-rust-toolchain.mjs tauri build && node scripts/finalize-desktop-build.mjs",
    "desktop:manifest": "node scripts/finalize-desktop-build.mjs",
    "cli:build": "pnpm build && node scripts/run-with-rust-toolchain.mjs cargo build --manifest-path src-tauri/Cargo.toml --release --no-default-features --features cli --bin anchor",
    "start": "node scripts/run-with-rust-toolchain.mjs tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "node scripts/run-with-rust-toolchain.mjs tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/svelte": "^0.487.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "chrome-devtools-mcp": "^1.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
