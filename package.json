{
  "name": "anchor",
  "version": "0.1.23",
  "description": "Anchor Web Admin and CLI workspace gateway",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "admin:serve": "pnpm build && node scripts/run-with-rust-toolchain.mjs cargo run --manifest-path crates/anchor/Cargo.toml --bin anchor -- admin serve",
    "release:build": "pnpm cli:build",
    "cli:build": "pnpm build && node scripts/run-with-rust-toolchain.mjs cargo build --manifest-path crates/anchor/Cargo.toml --release --no-default-features --features cli --bin anchor",
    "start": "pnpm admin:serve",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "chrome-devtools-mcp": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
