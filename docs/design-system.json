{
  "version": "2.0.0",
  "name": "Anchor Web Admin",
  "productType": "Developer Tool Web Admin",
  "stack": {
    "build": "vite",
    "framework": "react",
    "router": "react-router-dom",
    "components": "shadcn/ui",
    "componentStyle": "base-nova",
    "css": "tailwindcss-4",
    "icons": "lucide-react",
    "themeRuntime": "next-themes"
  },
  "theme": {
    "default": "system",
    "modes": ["light", "dark", "system"],
    "baseColor": "neutral",
    "cssVariables": true,
    "radius": "0.625rem",
    "tokenSource": "src/app.css"
  },
  "typography": {
    "sans": "Geist Variable",
    "sansSource": "@fontsource-variable/geist",
    "technicalText": "Tailwind font-mono stack"
  },
  "layout": {
    "shell": "two-column web admin",
    "sidebarWidth": "16rem",
    "workspaceGrid": ["1 column", "2 columns at md", "3 columns at xl"],
    "smallViewport": "sidebar hidden below md in current AppShell"
  },
  "runtimeState": {
    "component": "src/components/admin/RuntimeBadge.tsx",
    "states": ["stopped", "starting", "running", "recovering", "stopping", "error"]
  },
  "sourceOfTruth": [
    "src/app.css",
    "components.json",
    "src/main.tsx",
    "src/components/ui",
    "src/components/admin/AppShell.tsx",
    "src/components/admin/RuntimeBadge.tsx",
    "src/pages"
  ],
  "historicalUiSpecs": "docs/specs may retain Desktop/Tauri/Svelte design records as historical evidence"
}
